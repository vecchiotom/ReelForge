# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelforge
POSTGRES_PORT=5432
# ── MinIO (S3-compatible storage) ────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reelforge
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── JWT ──────────────────────────────────────────────────
# REQUIRED. Random value of at least 32 characters — the app refuses to start
# otherwise. Generate one with: openssl rand -hex 32
JWT_SIGNING_KEY=
JWT_ISSUER=reelforge-api
JWT_AUDIENCE=reelforge-inference

# ── Azure OpenAI ─────────────────────────────────────────
# These are now the *fallback* chat-completion config, used only when no
# `inference_providers` row exists or no row is marked as the default —
# configure providers at runtime via /admin/inference-providers instead.
# Embeddings (VectorSearch__EmbeddingDeployment above) always use these keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── Anthropic / Claude (optional) ───────────────────────
# Claude is configured as an `inference_providers` row of kind `Anthropic` at
# /admin/inference-providers, not from here — these variables exist only so a
# provider row can store the literal `env:` as its api key, in which case the
# Anthropic SDK resolves credentials itself and no secret is persisted in the
# database. Handy for local development; see docs/anthropic-provider.md.
# A BLANK api key is rejected outright, deliberately: it would otherwise make a
# misconfigured or undecryptable row silently bill these credentials instead.
#
# CREDENTIAL BOUNDARY — read before filling either of these in:
#   A Claude Pro/Max subscription token (ANTHROPIC_AUTH_TOKEN, as minted by
#   `claude setup-token`) is licensed for ORDINARY, INDIVIDUAL use by the person
#   who owns it. That covers running ReelForge locally against your own account.
#   It does NOT cover a deployed ReelForge executing workflows for other people —
#   routing other users' requests through subscription credentials is explicitly
#   not permitted. Use a Console API key (ANTHROPIC_API_KEY) or Bedrock/Vertex/
#   Foundry for anything user-facing.
#   https://code.claude.com/docs/en/legal-and-compliance
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# ── SMTP (optional — logs OTP to console if not set) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Initial Admin User ──────────────────────────────────
ADMIN_EMAIL=admin@reelforge.local
# Leave empty to auto-generate a random password, printed once to the go-api
# container logs on first boot. A password change is always forced on first login.
ADMIN_PASSWORD=

# ── Workflow Engine ──────────────────────────────────────
WORKFLOW_MAX_CONCURRENCY=4
VECTOR_QDRANT_GRPC_PORT=6334
VECTOR_CHUNK_SIZE_TOKENS=512
VECTOR_CHUNK_OVERLAP_TOKENS=64
VECTOR_SMALL_FILE_THRESHOLD_TOKENS=1500

# ── Sandbox Executor (runs untrusted, model-authored Remotion code) ─
# REQUIRED. Shared secret between the workflow engine and the sandbox service.
# The service refuses to start if this is empty: its API can start containers and
# read/write files, and it holds the Docker socket. Generate a fresh one with:
#   openssl rand -hex 32
SANDBOX_API_TOKEN=

# Leave false. The sandbox docker network is then created with --internal, which
# removes its default route: sandboxed code reaches neither the internet nor the
# host gateway (and therefore none of the ports published above). Setting this to
# true is what re-enables `POST /api/v1/sandboxes/{id}/packages` (runtime
# npm install) — and simultaneously lets attacker-controlled code inside the
# sandbox talk to the network. Prefer baking dependencies into the runtime image.
SANDBOX_NETWORK_EGRESS=false

SANDBOX_TTL=1h
SANDBOX_EXEC_TIMEOUT=5m
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
SANDBOX_PIDS_LIMIT=256

# ── Video Editing (ffmpeg/ffprobe, runs inside workflow-engine) ─────
VIDEO_MAX_CONCURRENT_JOBS=1
VIDEO_ANALYZE_TIMEOUT_SECONDS=900
VIDEO_COMPILE_TIMEOUT_SECONDS=1800
# Font used by Phase 3 motion-graphics overlays (drawtext). Must exist in the workflow-engine
# image — the default matches the font-dejavu Alpine package the Dockerfile installs.
VIDEO_FONT_FILE=/usr/share/fonts/dejavu/DejaVuSans.ttf

# Host port for the local `whisper` ASR container (CPU Whisper-API-compatible server, used for
# VideoAnalyze transcription). Not consumed automatically — register it as a Transcription-capability
# inference_providers row via /admin/inference-providers to actually use it.
WHISPER_PORT=9002

# ── TLS (see docs/tls.md) ────────────────────────────────
# Leave DOMAIN empty for local development: nginx serves both http:// and a
# self-signed https:// out of the box (browsers will warn on the self-signed
# cert — that's expected, not a bug).
#
# Once you have a real domain pointed at this server's public IP:
#   1. Set DOMAIN and ACME_EMAIL below.
#   2. docker compose --profile tls up -d caddy
#   3. docker compose up -d --force-recreate nginx
#      (picks up the Let's Encrypt cert Caddy just obtained; renewals after
#      this are picked up automatically, no further steps needed)
#   4. Once you've confirmed https://<DOMAIN> works, set FORCE_HTTPS=true and
#      restart nginx to redirect http:// to https://.
DOMAIN=
ACME_EMAIL=
FORCE_HTTPS=false

# Set to true once real TLS (step 3 above) is actually serving https:// —
# browsers silently drop Secure cookies over plain http://, so leave this
# false for http://localhost development or login will stop working.
COOKIE_SECURE=false

# ── Service Ports (host-side) ────────────────────────────
APP_PORT=80
HTTPS_PORT=443
API_PORT=3000
INFERENCE_PORT=3001

# ── ASP.NET Environment ─────────────────────────────────
# Development = Swagger enabled | Production = Swagger disabled
ASPNETCORE_ENVIRONMENT=Development

# ── Next.js Web App Build Mode ──────────────────────────
# development = Turbopack dev server with hot reload (requires volumes)
# production  = Precompiled standalone build (optimized, no hot reload)
WEB_BUILD_TARGET=development
WEB_NODE_ENV=development

# Node inspector. Unauthenticated code execution for anyone who can reach the
# port. Bound to container-local loopback (not just the host-side port
# publish below) so nothing else on the docker network can reach it either.
# Set this to empty for any deployment that is not a developer's own machine.
WEB_NODE_OPTIONS=--inspect=127.0.0.1:9229

# Note: When using WEB_BUILD_TARGET=production:
# 1. Comment out or remove the volume mounts in docker-compose.yml web service
# 2. Set WEB_NODE_ENV=production
# 3. The app will run the optimized, precompiled standalone server

# ── Public Marketing Site (`/site`) ─────────────────────
SITE_BUILD_TARGET=development
SITE_NODE_ENV=development
# Canonical absolute origin. Used for canonical URLs, sitemap.xml,
# robots.txt, Open Graph and JSON-LD. Swap this one value on launch.
NEXT_PUBLIC_SITE_URL=https://reelforge.com
# Google Analytics 4. Leave EMPTY to disable analytics entirely — no
# script is injected when unset. Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Where contact-form submissions are POSTed as JSON. Leave empty and
# submissions are only written to the site container's stdout.
CONTACT_WEBHOOK_URL=