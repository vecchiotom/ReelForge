# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reelforge
POSTGRES_PORT=5432
# ── MinIO (S3-compatible storage) ────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=reelforge
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── JWT ──────────────────────────────────────────────────
JWT_SIGNING_KEY=change-me-to-a-strong-secret
JWT_ISSUER=reelforge-api
JWT_AUDIENCE=reelforge-inference

# ── Azure OpenAI ─────────────────────────────────────────
# These are now the *fallback* chat-completion config, used only when no
# `inference_providers` row exists or no row is marked as the default —
# configure providers at runtime via /admin/inference-providers instead.
# Embeddings (VectorSearch__EmbeddingDeployment above) always use these keys.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ── SMTP (optional — logs OTP to console if not set) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ── Initial Admin User ──────────────────────────────────
ADMIN_EMAIL=admin@reelforge.local
ADMIN_PASSWORD=test

# ── Workflow Engine ──────────────────────────────────────
WORKFLOW_MAX_CONCURRENCY=4
VECTOR_QDRANT_GRPC_PORT=6334
VECTOR_CHUNK_SIZE_TOKENS=512
VECTOR_CHUNK_OVERLAP_TOKENS=64
VECTOR_SMALL_FILE_THRESHOLD_TOKENS=1500

# ── Sandbox Executor (runs untrusted, model-authored Remotion code) ─
# REQUIRED. Shared secret between the workflow engine and the sandbox service.
# The service refuses to start if this is empty: its API can start containers and
# read/write files, and it holds the Docker socket. Generate a fresh one with:
#   openssl rand -hex 32
SANDBOX_API_TOKEN=

# Leave false. The sandbox docker network is then created with --internal, which
# removes its default route: sandboxed code reaches neither the internet nor the
# host gateway (and therefore none of the ports published above). Setting this to
# true is what re-enables `POST /api/v1/sandboxes/{id}/packages` (runtime
# npm install) — and simultaneously lets attacker-controlled code inside the
# sandbox talk to the network. Prefer baking dependencies into the runtime image.
SANDBOX_NETWORK_EGRESS=false

SANDBOX_TTL=1h
SANDBOX_EXEC_TIMEOUT=5m
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_LIMIT=2
SANDBOX_PIDS_LIMIT=256

# ── Video Editing (ffmpeg/ffprobe, runs inside workflow-engine) ─────
VIDEO_MAX_CONCURRENT_JOBS=1
VIDEO_ANALYZE_TIMEOUT_SECONDS=900
VIDEO_COMPILE_TIMEOUT_SECONDS=1800

# ── Service Ports (host-side) ────────────────────────────
APP_PORT=80
API_PORT=3000
INFERENCE_PORT=3001

# ── ASP.NET Environment ─────────────────────────────────
# Development = Swagger enabled | Production = Swagger disabled
ASPNETCORE_ENVIRONMENT=Development

# ── Next.js Web App Build Mode ──────────────────────────
# development = Turbopack dev server with hot reload (requires volumes)
# production  = Precompiled standalone build (optimized, no hot reload)
WEB_BUILD_TARGET=development
WEB_NODE_ENV=development

# Node inspector. Unauthenticated code execution for anyone who can reach the
# port, so it is published on loopback only. Set this to empty for any deployment
# that is not a developer's own machine.
WEB_NODE_OPTIONS=--inspect=0.0.0.0:9229

# Note: When using WEB_BUILD_TARGET=production:
# 1. Comment out or remove the volume mounts in docker-compose.yml web service
# 2. Set WEB_NODE_ENV=production
# 3. The app will run the optimized, precompiled standalone server