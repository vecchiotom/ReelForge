{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=reelforge;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "reelforge-api",
    "Audience": "reelforge-inference",
    "SigningKey": ""
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "gpt-4o-mini",
    "ApiKey": ""
  },
  "DataProtection": {
    "KeysPath": "/keys"
  },
  "Inference": {
    "ProviderCacheSeconds": 60
  },
  "VideoEditing": {
    "ScratchPath": "/var/tmp/reelforge-video",
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaxConcurrentJobs": 1,
    "AnalyzeTimeoutSeconds": 900,
    "CompileTimeoutSeconds": 1800
  },
  "MinIO": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "reelforge"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "InferenceApi": {
    "BaseUrl": "http://localhost:8080"
  },
  "Sandbox": {
    "BaseUrl": "http://sandbox-executor:8080"
  },
  "WorkflowEngine": {
    "MaxConcurrency": 4,
    "AgentParallelism": 4,
    "AgentRunTimeoutSeconds": 3000
  },
  "WorkflowHardening": {
    "EnableStructuredRetryDiagnostics": true,
    "MaxStepRetries": 3,
    "MaxAuthorStepRetries": 3,
    "MaxTranslatorStepRetries": 3,
    "RetryBaseDelaySeconds": 2
  }
}
